{
  "name": "meesho-c2m-launchpad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "C2M Launchpad - working prototype of Team Deckheads' (IIT Madras) Meesho DICE Challenge S3 C2M solution",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview-file": "vite build --mode singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
